# Required: Google AI Studio API key (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown)
PORT=8000
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
# Models tried when the primary returns a rate-limit or overload response.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
LLM_TIMEOUT_MS=12000
LLM_MAX_ATTEMPTS=3

# Optional: several comma-separated keys are rotated round-robin to multiply the
# free-tier per-key rate limit. Takes precedence over GEMINI_API_KEY when set.
# GEMINI_API_KEYS=key_one,key_two
LLM_TOTAL_BUDGET_MS=20000
